# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://followme:followme@localhost:5432/followme
# Separate database used by automated tests (created automatically by the test harness)
TEST_DATABASE_URL=postgresql://followme:followme@localhost:5432/followme_test

# Public base URL (used in controlled-source references, QR codes, exports)
APP_BASE_URL=http://localhost:3000

# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Enable the local user picker (role simulation). MUST be false in production.
AUTH_MODE=local            # local | entra
# Entra ID (OIDC) - architecture only in MVP, see docs/02-architecture/integrations.md
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# 32-byte key, base64. Enables AES-256-GCM encryption of stored assets. Generate: openssl rand -base64 32
ASSET_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRldi1vbmx5LWtleS0xMjM0NTY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=followme
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# AI provider: local (deterministic, no network) | anthropic | openai-compatible
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Malware scanning: builtin (heuristic dev scanner) | clamav
MALWARE_SCANNER=builtin
CLAMAV_HOST=
CLAMAV_PORT=3310

# OCR: tesseract (CLI) | none
OCR_PROVIDER=tesseract

# Run background jobs inside the web process (dev convenience). Production: run `npm run worker`.
JOBS_INLINE=true

# Allow the local role-simulation login in a production build (throwaway demos only; never in real deployments)
# DEMO_MODE=true
